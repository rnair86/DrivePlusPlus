{
  "rabbit_version": "3.13",
  "users": [
    {
      "name": "admin_user",
      "password": "AdminPassword123",
      "tags": "administrator"
    },
    {
      "name": "application_user",
      "password": "AppPassword123",
      "tags": ""
    },
    {
      "name": "appointment_user",
      "password": "AppointmentPassword123",
      "tags": ""
    },
    {
