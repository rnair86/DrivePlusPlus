      "tags": ""
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "admin_user",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "application_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^$"
    },
    {
      "user": "appointment_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^$"
    },
    {
      "user": "course_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^$"
    },
    {
      "user": "test_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^$"
    },
