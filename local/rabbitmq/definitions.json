      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notif.q.test-events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notif.q.payment-events",
