      "source": "dpp.events",
      "vhost": "/",
      "destination": "payment.q.enrollment-events",
      "destination_type": "queue",
      "routing_key": "course.enrollment.created",
      "arguments": {}
    },
    {
      "source": "dpp.events",
      "vhost": "/",
      "destination": "preferences.q.user-events",
      "destination_type": "queue",
      "routing_key": "user.student.registered",
      "arguments": {}
