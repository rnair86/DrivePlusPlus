      "user": "payment_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^payment\\.q\\.enrollment-events$"
    },
    {
      "user": "notification_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^notif\\.q\\.(user-events|class-events|appointment-events|test-events|payment-events|preference-updates)$"
    },
    {
      "user": "preferences_user",
      "vhost": "/",
      "configure": "^$",
      "write": "^dpp\\.events$",
      "read": "^preferences\\.q\\.user-events$"
    }
  ],
  "exchanges": [
    {
      "name": "dpp.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "payment.q.enrollment-events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "preferences.q.user-events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notif.q.user-events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notif.q.class-events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notif.q.appointment-events",
